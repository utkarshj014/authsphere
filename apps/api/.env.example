# AuthSphere Environment Configuration

# Note: AuthSphere uses process-aware environment partitioning.
# - Shared: NODE_ENV, APP_ROLE, QUEUE_DRIVER, FRONTEND_URL, REDIS_URL (used by both API & Worker)
# - API Role: DATABASE_URL, PORT, HOST, TRUST_PROXY, JWT, MFA, OAuth
#   (Plus RESEND_API_KEY and EMAIL_FROM when QUEUE_DRIVER=inline)
# - Worker Role: RESEND_API_KEY, EMAIL_FROM

# --- General (Shared Infrastructure) ---
# Application environment (development | production | test)
NODE_ENV=development

# Process role: api (default, runs Express REST API) | worker (runs standalone BullMQ queue consumer)
APP_ROLE=api

# Background Queue Driver:
# - bullmq: (default) enqueues jobs to Redis; consumed by standalone email worker
# - inline: dispatches emails asynchronously in-process (ideal for demos, low-traffic cloud VMs)
# - sync: dispatches emails synchronously inside the request handler (required by AWS Lambda to prevent freezing)
QUEUE_DRIVER=bullmq

# The port on which the API server will listen
PORT=3000

# The host on which the API server will listen
HOST=0.0.0.0

# The base URL of the frontend application (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# Express proxy trust configuration: false (default), true, hop count integer (e.g., 1), or subnet list
TRUST_PROXY=false

# --- Redis Cache & Queue (Shared Infrastructure) ---
# Connection string for Redis instance used for caching, rate limiting, and BullMQ queues
REDIS_URL=redis://localhost:6379

# --- Database ---
# Connection string for the PostgreSQL database
# Local
DATABASE_URL=
# Docker
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authsphere"

# --- Authentication ---
# Secret keys for signing JSON Web Tokens. Must be long, random, and cryptographically secure.
JWT_ACCESS_SECRET=some-long-random-secret
JWT_REFRESH_SECRET=some-long-random-secret

# Token expiration durations (e.g., 15m, 30d, 1h)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Token reuse deletion mode: SESSION (delete compromised session) | GLOBAL (delete all sessions for user)
AUTH_REUSE_DELETION_MODE=SESSION

# Refresh token leeway grace period in seconds (absorbs concurrent SPA / multi-tab refresh races)
AUTH_REFRESH_TOKEN_LEEWAY_SECONDS=30

# Secret key used for symmetric AES-256-GCM encryption of MFA secrets at rest (minimum 16 characters)
MFA_ENCRYPTION_KEY=some-long-random-mfa-encryption-key

# --- OAuth 2.0 Identity Providers ---
# Google OAuth 2.0 Credentials (obtained from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0 Credentials (obtained from GitHub Developer Settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Base URL for OAuth callback redirects. AuthSphere appends /:provider/callback to form the full redirect URI.
# - Local Direct: http://localhost:3000/auth/oauth
# - Production (via Vercel Edge Proxy): https://<your-project>.vercel.app/api/auth/oauth
OAUTH_CALLBACK_BASE_URL=http://localhost:3000/auth/oauth

# --- Email Delivery (Strategy: Gmail OAuth2 or Resend) ---
# Active Provider: "gmail" (default if GMAIL_REFRESH_TOKEN set) or "resend"
EMAIL_PROVIDER=gmail

# Option A: Google Gmail OAuth2 (Recommended for portfolio/demos; sends to arbitrary recipients with NO custom domain)
# Reuses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET configured above.
GMAIL_USER=your_email@gmail.com
GMAIL_REFRESH_TOKEN=1//your-google-oauth-refresh-token

# Option B: Resend (Requires verified custom domain for arbitrary recipients)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Resend sender address for outgoing emails (display name included)
EMAIL_FROM=AuthSphere <noreply@authsphere.dev>