# AuthSphere Test Environment Configuration
#
# --- General ---
NODE_ENV=test
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
APP_ROLE=api
QUEUE_DRIVER=inline

# --- Database (Prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authsphere_test

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/1

# --- Authentication (JWT) ---
JWT_ACCESS_SECRET=test-access-secret-minimum-16-chars
JWT_REFRESH_SECRET=test-refresh-secret-minimum-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_REUSE_DELETION_MODE=SESSION
AUTH_REFRESH_TOKEN_LEEWAY_SECONDS=30
MFA_ENCRYPTION_KEY=test-mfa-encryption-key-min16

# --- OAuth 2.0 Identity Providers ---
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret
OAUTH_CALLBACK_BASE_URL=http://localhost:3001/auth/oauth

# --- Email Provider ---
# Options: 'resend' (default) | 'gmail'
EMAIL_PROVIDER=resend
RESEND_API_KEY=resend_test_dummy_key_for_testing
EMAIL_FROM=AuthSphere <noreply@authsphere.dev>
# For Gmail OAuth2 (alternative):
# GMAIL_USER=test@gmail.com
# GMAIL_REFRESH_TOKEN=test-refresh-token
# (re-uses top-level GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET)