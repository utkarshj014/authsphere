{
  "family": "authsphere-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "authsphere-worker",
      "image": "authsphere-api:latest",
      "essential": true,
      "command": [
        "node",
        "--enable-source-maps",
        "dist/workers/email.worker.js"
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "APP_ROLE",
          "value": "worker"
        },
        {
          "name": "QUEUE_DRIVER",
          "value": "bullmq"
        }
      ],
      "secrets": [
        {
          "name": "REDIS_URL",
          "valueFrom": "/authsphere/REDIS_URL"
        },
        {
          "name": "FRONTEND_URL",
          "valueFrom": "/authsphere/FRONTEND_URL"
        },
        {
          "name": "RESEND_API_KEY",
          "valueFrom": "/authsphere/RESEND_API_KEY"
        },
        {
          "name": "EMAIL_FROM",
          "valueFrom": "/authsphere/EMAIL_FROM"
        },
        {
          "name": "EMAIL_PROVIDER",
          "valueFrom": "/authsphere/EMAIL_PROVIDER"
        },
        {
          "name": "GMAIL_USER",
          "valueFrom": "/authsphere/GMAIL_USER"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "/authsphere/GOOGLE_CLIENT_ID"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "/authsphere/GOOGLE_CLIENT_SECRET"
        },
        {
          "name": "GMAIL_REFRESH_TOKEN",
          "valueFrom": "/authsphere/GMAIL_REFRESH_TOKEN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/authsphere-worker",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
